S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Liveness heartbeat -> orchestrator. While a user has a live socket open, the
# runner POSTs to ORCHESTRATOR_URL/heartbeat so the orchestrator's reaper knows
# the workspace is in use. Leave ORCHESTRATOR_URL empty to disable heartbeats.
ORCHESTRATOR_URL=http://orchestrator-simple:3002
HEARTBEAT_INTERVAL_MS=30000

# Must match the orchestrator's INTERNAL_TOKEN so heartbeats are accepted.
INTERNAL_TOKEN=

# Verifies the per-workspace socket-handshake token. Must match the
# orchestrator's WORKSPACE_TOKEN_SECRET. When set, a connection must present a
# token scoped to this pod's replId. (Legacy shared RUNNER_AUTH_TOKEN still works
# as a fallback when this is unset.)
WORKSPACE_TOKEN_SECRET=
