# init-service (control plane) base URL
VITE_CONTROL_PLANE_URL=http://localhost:3001
# orchestrator-simple base URL
VITE_ORCHESTRATOR_URL=http://localhost:3002
# Wildcard domain workspace pods are reached at over Socket.IO (<replId>.<domain>)
VITE_WORKSPACE_BASE_DOMAIN=peetcode.com
# Output preview iframe base domain (separate from the socket domain above)
VITE_OUTPUT_BASE_DOMAIN=autogpt-cloud.com
# Google OAuth 2.0 Web Client ID (must match the backend's GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=
