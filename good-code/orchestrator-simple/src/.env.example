S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# JWT_SECRET: MUST be identical to init-service's JWT_SECRET so this service can
# verify the session tokens init-service issues. /start is rejected without a
# valid Bearer token.
JWT_SECRET=

# Read-only view of the repls collection init-service writes. Used to authorize
# /start and /stop against the recorded owner of a workspace. Point these at the
# SAME database as init-service.
MONGODB_URI=
MONGODB_DB_NAME=repl

# Idle reaping: a workspace with no runner heartbeat for longer than this is
# deleted by the reaper CronJob's POST /reap sweep. Default 30 min.
IDLE_TTL_MS=1800000

# Shared secret for internal machine-to-machine calls (runner /heartbeat and the
# reaper /reap). Must match the runner's INTERNAL_TOKEN and the reaper Secret.
# If unset, those endpoints are unauthenticated (dev only).
INTERNAL_TOKEN=

# Signs the per-workspace token minted at /start that the browser presents in the
# runner's socket handshake (data-plane auth). Must match the runner's
# WORKSPACE_TOKEN_SECRET. If unset, no token is minted and pod-level auth is off.
WORKSPACE_TOKEN_SECRET=
WORKSPACE_TOKEN_TTL=12h
