S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
MONGODB_URI=
MONGODB_DB_NAME=repl

# Auth (Google OAuth2 / GIS ID-token flow)
# GOOGLE_CLIENT_ID: the OAuth 2.0 Web Client ID from Google Cloud Console.
#   Must match VITE_GOOGLE_CLIENT_ID used by the frontend.
GOOGLE_CLIENT_ID=
# JWT_SECRET: long random string used to sign session tokens. MUST be identical
#   to orchestrator-simple's JWT_SECRET so it can verify the same tokens.
JWT_SECRET=
# JWT_EXPIRES_IN: session lifetime (vercel/ms format), e.g. 7d, 24h. Default 7d.
JWT_EXPIRES_IN=7d
# MAX_REPLS_PER_USER: per-user active-workspace cap. Default 5.
MAX_REPLS_PER_USER=5
